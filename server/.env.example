# Server Configuration
PORT=3001
NODE_ENV=development

# API Configuration
API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Provider: "supabase" or "local" (auto-detected from SUPABASE_URL if omitted)
# DB_PROVIDER=local

# Supabase Configuration (required for supabase mode, omit for local mode)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key-here

# Local Mode Configuration
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters
# LOCAL_DATA_DIR=./data          # SQLite DB and local file storage location

# OpenAI Configuration (server-wide fallback key; users can also bring their own)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Encryption secret for storing per-user API keys (min 32 chars)
ENCRYPTION_SECRET=change-me-to-a-random-string-at-least-32-characters

# ChatGPT OAuth (optional — enables "Sign in with ChatGPT" button)
# CHATGPT_CLIENT_ID=your-openai-oauth-client-id
# CHATGPT_CLIENT_SECRET=your-openai-oauth-client-secret
# CHATGPT_REDIRECT_URI=http://localhost:3001/api/auth/chatgpt/callback
# EXCHANGE_OPENAI_API_KEY=true      # auto-provision OpenAI key from ChatGPT subscription

# Redis Configuration (for job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional: Use Railway Redis
# REDIS_HOST=your-railway-redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000      # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100      # max requests per window
JOB_RATE_LIMIT_MAX=20            # max jobs per hour
